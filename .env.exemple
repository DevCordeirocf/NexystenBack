# ==========================================
# Configurações do Servidor
# ==========================================
NODE_ENV=development
PORT=3001

# ==========================================
# Banco de Dados (PostgreSQL via Prisma)
# ==========================================
# Formato padrão: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nexysten_db?schema=public"

# ==========================================
# Autenticação e Segurança (JWT)
# ==========================================
# Chave secreta utilizada para assinar os tokens JWT (utilize uma string forte em produção)
JWT_SECRET="sua_chave_secreta_aqui"

# Tempo de expiração do token de acesso (ex: 1d, 8h, 60m)
JWT_EXPIRATION="1d"

# ==========================================
# Configurações de Upload de Arquivos
# ==========================================
# Variáveis utilizadas pelo módulo Upload (descomente e ajuste conforme o provedor utilizado)
# STORAGE_PROVIDER=local # Opções: local, s3, cloudinary, etc.

# Exemplo para AWS S3 (caso implementado):
# AWS_ACCESS_KEY_ID="sua_access_key_aqui"
# AWS_SECRET_ACCESS_KEY="sua_secret_key_aqui"
# AWS_REGION="sa-east-1"
# AWS_BUCKET_NAME="nome_do_seu_bucket"